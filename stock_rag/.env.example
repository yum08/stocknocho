# ─────────────────────────────────────────────────────────────────
# StockRAG Environment Configuration
# ─────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your keys.

# Apify (for scraping Telegram, X.com, LinkedIn)
APIFY_API_TOKEN=your_apify_token_here

# LLM Provider (choose one: gemini, openai, ollama)
STOCKRAG_LLM_PROVIDER=gemini

# Google Gemini API Key (get from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_key_here

# OpenAI API Key (alternative to Gemini)
# OPENAI_API_KEY=your_openai_key_here

# Ollama (local LLM - no key needed, just install Ollama)
# OLLAMA_MODEL=llama3.1

# Database paths
STOCKRAG_DB_PATH=stock_rag.db
STOCKRAG_VECTOR_DIR=./chroma_db

# Telegram (for Telethon direct scraping - optional)
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_SESSION=telegram_session
